# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Upstash Redis (for schedule caching)
UPSTASH_REDIS_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# Cron job secret (optional, for manual cron triggers)
CRON_SECRET=your-secret-key

# GitHub Actions (for liquipedia workflow dispatch)
GITHUB_ACTIONS_TOKEN=your-github-pat-token
